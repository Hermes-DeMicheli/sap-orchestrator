# SAP Orchestrator - environment variables

# Server
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8000
ORCHESTRATOR_LOG_LEVEL=INFO

# SAP HANA Cloud
HANA_CONN_STR=your-hana-connection-string

# BTP Destinations
BTP_DEST_URL=https://your-btp-instance.cfapps.eu10.hana.ondemand.com

# ABAP Cloud
ABAP_CLOUD_URL=https://your-abap-cloud.cfapps.eu10.hana.ondemand.com

# Circuit breaker
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_SECONDS=30

# Retry
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=1
